---
// apps/site/src/pages/stack.astro
import Base from "../layouts/Base.astro";
import { TOOLCHAIN, STACK_NOTE, RUNTIME } from "../data/research";
---
<Base
  title="Stack"
  lead="Every executable version is declared once, and a wrong artifact fails at
        check time rather than surfacing later as a difference between machines."
>
  <h2>Pinned executables</h2>
  <table>
    <thead><tr><th>Tool</th><th>Version</th><th>Why</th></tr></thead>
    <tbody>
      {TOOLCHAIN.map((t) => (
        <tr><td><code>{t.name}</code></td><td><code>{t.version}</code></td><td>{t.why}</td></tr>
      ))}
    </tbody>
  </table>
  <p class="note">{STACK_NOTE}</p>

  <h2>Runtime</h2>
  <dl>
    {RUNTIME.map((r) => (<><dt>{r.layer}</dt><dd>{r.what}</dd></>))}
  </dl>

  <style>
    h2 { margin-top: 2rem; font-size: 1.05rem; }
    table { border-collapse: collapse; width: 100%; font-size: .88rem; }
    th { text-align: left; font-size: .68rem; text-transform: uppercase;
         letter-spacing: .06em; color: var(--muted);
         border-bottom: 2px solid var(--ink); padding: 0 .5rem .35rem; }
    td { padding: .5rem; border-bottom: 1px solid var(--hair); vertical-align: top; }
    code { font-family: ui-monospace, Menlo, monospace; font-size: .82rem; }
    .note { color: var(--muted); font-size: .85rem; max-width: 46rem;
            border-left: 3px solid var(--teal); padding-left: .9rem; }
    dt { font-weight: 700; font-size: .88rem; margin-top: .7rem; }
    dd { margin: .15rem 0 0; font-size: .88rem; color: var(--muted); }
  </style>
</Base>

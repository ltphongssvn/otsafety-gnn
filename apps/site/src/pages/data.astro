---
// apps/site/src/pages/data.astro
import Base from "../layouts/Base.astro";
import { SOURCES } from "../data/research";
---
<Base
  title="Data"
  lead="A public, open-source knowledge graph is the specification, so what can and
        cannot be redistributed is part of the method rather than a footnote."
>
  {SOURCES.map((s) => (
    <section class="src">
      <h2>{s.name} <span class={s.open ? "open" : "closed"}>
        {s.open ? "open" : "licensed"}</span></h2>
      <p>{s.role}</p>
      <p class="lic"><strong>Licence:</strong> {s.licence}</p>
    </section>
  ))}
  <style>
    .src { border-bottom: 1px solid var(--hair); padding: 1rem 0; }
    .src h2 { font-size: 1rem; margin: 0 0 .4rem; }
    .open { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em;
            color: var(--teal); border: 1px solid var(--teal); border-radius: 3px;
            padding: .05rem .35rem; }
    .closed { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em;
              color: var(--red); border: 1px solid var(--red); border-radius: 3px;
              padding: .05rem .35rem; }
    .src p { font-size: .88rem; margin: .3rem 0; }
    .lic { color: var(--muted); }
  </style>
</Base>

{
  "additionalProperties": false,
  "description": "contracts/repository-settings.json, as committed.",
  "properties": {
    "$comment": {
      "default": "",
      "title": "$Comment",
      "type": "string"
    },
    "contract": {
      "const": "repository-settings/v1",
      "title": "Contract",
      "type": "string"
    },
    "settings": {
      "additionalProperties": false,
      "description": "The merge policy: merge commits only, and merged branches deleted.",
      "properties": {
        "allow_merge_commit": {
          "title": "Allow Merge Commit",
          "type": "boolean"
        },
        "allow_squash_merge": {
          "title": "Allow Squash Merge",
          "type": "boolean"
        },
        "allow_rebase_merge": {
          "title": "Allow Rebase Merge",
          "type": "boolean"
        },
        "allow_auto_merge": {
          "title": "Allow Auto Merge",
          "type": "boolean"
        },
        "delete_branch_on_merge": {
          "title": "Delete Branch On Merge",
          "type": "boolean"
        }
      },
      "required": [
        "allow_merge_commit",
        "allow_squash_merge",
        "allow_rebase_merge",
        "allow_auto_merge",
        "delete_branch_on_merge"
      ],
      "title": "MergeSettings",
      "type": "object"
    },
    "protection": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": false,
            "description": "What the remote must refuse on one branch, whatever a clone's hooks say.\n\nA SIBLING OF THE MERGE POLICY, NOT PART OF IT: a ruleset is a different\nendpoint with a different shape, and one model covering both would let a\ncheck report a verdict on settings it never read.",
            "properties": {
              "branch": {
                "title": "Branch",
                "type": "string"
              },
              "allow_force_pushes": {
                "default": false,
                "title": "Allow Force Pushes",
                "type": "boolean"
              },
              "allow_deletions": {
                "default": false,
                "title": "Allow Deletions",
                "type": "boolean"
              },
              "require_pull_request": {
                "default": true,
                "title": "Require Pull Request",
                "type": "boolean"
              }
            },
            "required": [
              "branch"
            ],
            "title": "BranchProtection",
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protection"
    }
  },
  "required": [
    "contract",
    "settings"
  ],
  "title": "SettingsFile",
  "type": "object"
}
